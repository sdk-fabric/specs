  "definitions": {
    "Channel": {
      "description": "Represents a Discord guild or DM channel.",
      "type": "struct",
      "properties": {
        "id": {
          "description": "The id of this channel",
          "type": "string"
        },
        "type": {
          "description": "The type of channel",
          "type": "integer"
        },
        "guild_id": {
          "description": "The id of the guild (may be missing for DM channels)",
          "type": "string"
        },
        "position": {
          "description": "Sorting position of the channel",
          "type": "integer"
        },
        "name": {
          "description": "The name of the channel (1-100 characters)",
          "type": "string"
        },
        "topic": {
          "description": "The channel topic (0-4096 characters)",
          "type": "string"
        },
        "nsfw": {
          "description": "Whether the channel is nsfw",
          "type": "boolean"
        },
        "last_message_id": {
          "description": "The id of the last message sent in this channel",
          "type": "string"
        },
        "bitrate": {
          "description": "The bitrate (in bits) of the voice channel",
          "type": "integer"
        },
        "user_limit": {
          "description": "The user limit of the voice channel",
          "type": "integer"
        },
        "rate_limit_per_user": {
          "description": "Amount of seconds a user has to wait before sending another message",
          "type": "integer"
        },
        "icon": {
          "description": "Icon hash",
          "type": "string"
        },
        "owner_id": {
          "description": "Id of the creator of the channel",
          "type": "string"
        },
        "application_id": {
          "description": "Application id of the group DM creator if it was bot-created",
          "type": "string"
        },
        "managed": {
          "description": "Whether the channel is managed by an application",
          "type": "boolean"
        },
        "parent_id": {
          "description": "For guild channels: id of the parent category",
          "type": "string"
        },
        "last_pin_timestamp": {
          "description": "When the last pinned message was pinned",
          "type": "string"
        },
        "rtc_region": {
          "description": "Voice region id for the voice channel",
          "type": "string"
        },
        "video_quality_mode": {
          "description": "The camera video quality mode of the voice channel",
          "type": "integer"
        },
        "message_count": {
          "description": "Number of messages in a thread channel",
          "type": "integer"
        },
        "member_count": {
          "description": "An approximate count of users in a thread channel",
          "type": "integer"
        },
        "default_auto_archive_duration": {
          "description": "Default duration for newly created threads to automatically archive",
          "type": "integer"
        },
        "permissions": {
          "description": "Computed permissions for the invoking user in the channel",
          "type": "string"
        },
        "flags": {
          "description": "Channel flags",
          "type": "integer"
        },
        "total_message_sent": {
          "description": "Number of messages ever sent in a thread",
          "type": "integer"
        },
        "default_sort_order": {
          "description": "The default sort order type used to order posts in forum channels",
          "type": "integer"
        },
        "default_forum_layout": {
          "description": "The default forum layout view used to display posts in forum channels",
          "type": "integer"
        }
      }
    },
    "Channel_Invite_Create": {
      "description": "Request body for creating a channel invite.",
      "type": "struct",
      "properties": {
        "max_age": {
          "description": "Duration of invite in seconds before expiry, or 0 for never. Default 86400 (24 hours)",
          "type": "integer"
        },
        "max_uses": {
          "description": "Max number of uses or 0 for unlimited. Default 0",
          "type": "integer"
        },
        "temporary": {
          "description": "Whether this invite only grants temporary membership. Default false",
          "type": "boolean"
        },
        "unique": {
          "description": "If true, don't try to reuse a similar invite. Default false",
          "type": "boolean"
        },
        "target_type": {
          "description": "The type of target for this voice channel invite",
          "type": "integer"
        },
        "target_user_id": {
          "description": "The id of the user whose stream to display for this invite",
          "type": "string"
        },
        "target_application_id": {
          "description": "The id of the embedded application to open for this invite",
          "type": "string"
        }
      }
    },
    "Channel_Update": {
      "description": "Request body for updating a channel.",
      "type": "struct",
      "properties": {
        "name": {
          "description": "1-100 character channel name",
          "type": "string"
        },
        "type": {
          "description": "The type of channel",
          "type": "integer"
        },
        "position": {
          "description": "The position of the channel in the left-hand listing",
