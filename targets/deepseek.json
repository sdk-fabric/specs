{
  "operations": {
    "completions.create": {
      "path": "/v1/chat/completions",
      "method": "POST",
      "return": {
        "code": 200,
        "schema": {
          "type": "reference",
          "target": "Completion_Response"
        }
      },
      "arguments": {
        "payload": {
          "in": "body",
          "schema": {
            "type": "reference",
            "target": "Completion_Request"
          }
        }
      },
      "throws": [
        {
          "code": 999,
          "schema": {
            "type": "reference",
            "target": "Error"
          }
        }
      ],
      "description": "Creates a model response for the given chat conversation.",
      "stability": 1,
      "security": [],
      "authorization": true,
      "tags": []
    },
    "completions.fim": {
      "path": "/beta/completions",
      "method": "POST",
      "return": {
        "code": 200,
        "schema": {
          "type": "reference",
          "target": "Fim_Completion_Response"
        }
      },
      "arguments": {
        "payload": {
          "in": "body",
          "schema": {
            "type": "reference",
            "target": "Fim_Completion_Request"
          }
        }
      },
      "throws": [
        {
          "code": 999,
          "schema": {
            "type": "reference",
            "target": "Error"
          }
        }
      ],
      "description": "Creates a Fill-In-the-Middle (FIM) code completion.",
      "stability": 1,
      "security": [],
      "authorization": true,
      "tags": []
    },
    "models.list": {
      "path": "/v1/models",
      "method": "GET",
      "return": {
        "code": 200,
        "schema": {
          "type": "reference",
          "target": "Model_List_Response"
        }
      },
      "throws": [
        {
          "code": 999,
          "schema": {
            "type": "reference",
            "target": "Error"
          }
        }
      ],
      "description": "Lists the currently available models.",
      "stability": 1,
      "security": [],
      "authorization": true,
      "tags": []
    },
    "user.get_balance": {
      "path": "/user/balance",
      "method": "GET",
      "return": {
        "code": 200,
        "schema": {
          "type": "reference",
          "target": "User_Balance_Response"
        }
      },
      "throws": [
        {
          "code": 999,
          "schema": {
            "type": "reference",
            "target": "Error"
          }
        }
      ],
      "description": "Retrieves the current user account balance information.",
      "stability": 1,
      "security": [],
      "authorization": true,
      "tags": []
    }
  },
  "definitions": {
    "Completion_Choice": {
      "description": "A choice generated by the chat completion model.",
      "type": "struct",
      "properties": {
        "index": {
          "description": "The index of the choice in the list of choices.",
          "type": "integer"
        },
        "message": {
          "description": "A chat completion message generated by the model.",
          "type": "reference",
          "target": "Completion_Message"
        },
        "finish_reason": {
          "description": "The reason the model stopped generating tokens.",
          "type": "string"
        },
        "logprobs": {
          "description": "Log probability information for the choice.",
          "type": "reference",
          "target": "Completion_Choice_Logprobs"
        }
      }
    },
    "Completion_Choice_Logprobs": {
      "description": "Log probability information for the choice.",
      "type": "struct",
      "properties": {
        "content": {
          "description": "A list of message content tokens with log probability information.",
          "type": "array",
          "schema": {
            "type": "reference",
            "target": "Completion_Token_Logprob"
          }
        }
      }
    },
    "Completion_Token_Logprob": {
      "description": "Log probability information for a token.",
      "type": "struct",
      "properties": {
        "token": {
          "description": "The token string.",
          "type": "string"
        },
        "logprob": {
          "description": "The log probability of this token.",
          "type": "number"
        },
        "bytes": {
          "description": "A list of integers representing the UTF-8 bytes representation of the token.",
          "type": "array",
          "schema": {
            "type": "integer"
          }
        },
        "top_logprobs": {
          "description": "List of the most likely tokens and their log probability at this token position.",
          "type": "array",
          "schema": {
            "type": "reference",
            "target": "Completion_Token_Top_Logprob"
          }
        }
      }
    },
    "Completion_Token_Top_Logprob": {
      "description": "Top log probability element.",
      "type": "struct",
      "properties": {
        "token": {
          "description": "The token string.",
          "type": "string"
        },
        "logprob": {
          "description": "The log probability of this token.",
          "type": "number"
        },
        "bytes": {
          "description": "A list of integers representing the UTF-8 bytes representation of the token.",
          "type": "array",
          "schema": {
            "type": "integer"
          }
        }
      }
    },
    "Completion_Message": {
      "description": "Base message struct for conversation context.",
      "type": "struct",
      "base": true,
      "properties": {
        "role": {
          "description": "The role of the author of this message.",
          "type": "string"
        },
        "content": {
          "description": "The contents of the message.",
          "type": "string"
        }
      },
      "discriminator": "role",
      "mapping": {
        "Completion_Message_System": "system",
        "Completion_Message_User": "user",
        "Completion_Message_Assistant": "assistant",
        "Completion_Message_Tool": "tool"
      }
    },
    "Completion_Message_Assistant": {
      "description": "Assistant message object.",
      "type": "struct",
      "parent": {
        "type": "reference",
        "target": "Completion_Message"
      },
      "properties": {
        "name": {
          "description": "An optional name for the participant.",
          "type": "string"
        },
        "prefix": {
          "description": "Set to true to force the model to continue the generation from the provided prefix.",
          "type": "boolean"
        },
        "reasoning_content": {
          "description": "The reasoning contents of the assistant message (Chain-of-Thought) produced during thinking mode.",
          "type": "string"
        },
        "tool_calls": {
          "description": "The tool calls generated by the model, such as function calls.",
          "type": "array",
          "schema": {
            "type": "reference",
            "target": "Completion_Tool_Call"
          }
        }
      }
    },
    "Completion_Message_System": {
      "description": "System message object.",
      "type": "struct",
      "parent": {
        "type": "reference",
        "target": "Completion_Message"
      },
      "properties": {
        "name": {
          "description": "An optional name for the participant.",
          "type": "string"
        }
      }
    },
    "Completion_Message_Tool": {
      "description": "Tool message object.",
      "type": "struct",
      "parent": {
        "type": "reference",
        "target": "Completion_Message"
      },
      "properties": {
        "tool_call_id": {
          "description": "Tool call that this message is responding to.",
          "type": "string"
        }
      }
    },
    "Completion_Message_User": {
      "description": "User message object.",
      "type": "struct",
      "parent": {
        "type": "reference",
        "target": "Completion_Message"
      },
      "properties": {
        "name": {
          "description": "An optional name for the participant.",
          "type": "string"
        }
      }
    },
    "Completion_Tool_Call": {
      "description": "A tool call generated by the model.",
      "type": "struct",
      "properties": {
        "id": {
          "description": "The ID of the tool call.",
          "type": "string"
        },
        "type": {
          "description": "The type of the tool. Currently, only 'function' is supported.",
          "type": "string"
        },
        "function": {
          "description": "The function that the model called.",
          "type": "reference",
          "target": "Completion_Tool_Call_Function"
        }
      }
    },
    "Completion_Tool_Call_Function": {
      "description": "The function call details.",
      "type": "struct",
      "properties": {
        "name": {
          "description": "The name of the function to call.",
          "type": "string"
        },
        "arguments": {
          "description": "The arguments to call the function with, as generated by the model in JSON format.",
          "type": "string"
        }
      }
    },
    "Completion_Tool": {
      "description": "Tool definition for function calling.",
      "type": "struct",
      "properties": {
        "type": {
          "description": "The type of the tool. Always 'function'.",
          "type": "string"
        },
        "function": {
          "description": "Function declaration details.",
          "type": "reference",
          "target": "Completion_Tool_Function"
        }
      }
    },
    "Completion_Tool_Function": {
      "description": "Function declaration details.",
      "type": "struct",
      "properties": {
        "name": {
          "description": "Name of the function.",
          "type": "string"
        },
        "description": {
          "description": "A description of what the function does.",
          "type": "string"
        },
        "parameters": {
          "description": "The parameters the function accepts, described as a JSON Schema object.",
          "type": "map"
        }
      }
    },
    "Completion_Response_Format": {
      "description": "An object specifying the format that the model must output.",
      "type": "struct",
      "properties": {
        "type": {
          "description": "Must be one of 'text' or 'json_object'.",
          "type": "string"
        }
      }
    },
    "Completion_Stream_Options": {
      "description": "Options for streaming responses.",
      "type": "struct",
      "properties": {
        "include_usage": {
          "description": "If set, an additional chunk with token usage details will be sent right before the [DONE] stream message.",
          "type": "boolean"
        }
      }
    },
    "Completion_Request": {
      "description": "Request payload for chat completion.",
      "type": "struct",
      "properties": {
        "model": {
          "description": "ID of the model to use (e.g., deepseek-chat, deepseek-reasoner).",
          "type": "string"
        },
        "messages": {
          "description": "A list of messages comprising the conversation so far.",
          "type": "array",
          "schema": {
            "type": "reference",
            "target": "Completion_Message"
          }
        },
        "frequency_penalty": {
          "description": "Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far.",
          "type": "number"
        },
        "max_tokens": {
          "description": "The maximum number of tokens that can be generated in the chat completion.",
          "type": "integer"
        },
        "logprobs": {
          "description": "Whether to return log probabilities of the output tokens or not.",
          "type": "boolean"
        },
        "presence_penalty": {
          "description": "Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far.",
          "type": "number"
        },
        "response_format": {
          "description": "An object specifying the format that the model must output.",
          "type": "reference",
          "target": "Completion_Response_Format"
        },
        "stop": {
          "description": "Up to 16 sequences where the API will stop generating further tokens.",
          "type": "array",
          "schema": {
            "type": "string"
          }
        },
        "stream": {
          "description": "If set, partial message deltas will be sent as server-sent events.",
          "type": "boolean"
        },
        "stream_options": {
          "description": "Options for streaming responses.",
          "type": "reference",
          "target": "Completion_Stream_Options"
        },
        "temperature": {
          "description": "Sampling temperature between 0 and 2.",
          "type": "number"
        },
        "tools": {
          "description": "A list of tools the model may call.",
          "type": "array",
          "schema": {
            "type": "reference",
            "target": "Completion_Tool"
          }
        },
        "top_logprobs": {
          "description": "An integer between 0 and 20 specifying the number of most likely tokens to return at each token position.",
          "type": "integer"
        },
        "top_p": {
          "description": "Nucleus sampling probability mass (between 0 and 1).",
          "type": "number"
        }
      }
    },
    "Completion_Usage": {
      "description": "Usage statistics for the completion request.",
      "type": "struct",
      "properties": {
        "completion_tokens": {
          "description": "Number of tokens in the generated completion.",
          "type": "integer"
        },
        "prompt_tokens": {
          "description": "Number of tokens in the prompt.",
          "type": "integer"
        },
        "prompt_cache_hit_tokens": {
          "description": "Number of tokens in the prompt that hit the context cache.",
          "type": "integer"
        },
        "prompt_cache_miss_tokens": {
          "description": "Number of tokens in the prompt that missed the context cache.",
          "type": "integer"
        },
        "total_tokens": {
          "description": "Total number of tokens used in the request (prompt + completion).",
          "type": "integer"
        }
      }
    },
    "Completion_Response": {
      "description": "Response structure for chat completion.",
      "type": "struct",
      "properties": {
        "id": {
          "description": "A unique identifier for the chat completion.",
          "type": "string"
        },
        "object": {
          "description": "The object type, which is always 'chat.completion'.",
          "type": "string"
        },
        "created": {
          "description": "The Unix timestamp (in seconds) of when the chat completion was created.",
          "type": "integer"
        },
        "model": {
          "description": "The model used for the chat completion.",
          "type": "string"
        },
        "choices": {
          "description": "A list of chat completion choices.",
          "type": "array",
          "schema": {
            "type": "reference",
            "target": "Completion_Choice"
          }
        },
        "system_fingerprint": {
          "description": "This fingerprint represents the backend configuration that the model runs with.",
          "type": "string"
        },
        "usage": {
          "description": "Usage statistics for the completion request.",
          "type": "reference",
          "target": "Completion_Usage"
        }
      }
    },
    "Fim_Completion_Request": {
      "description": "Request payload for Fill-In-the-Middle (FIM) completion.",
      "type": "struct",
      "properties": {
        "model": {
          "description": "ID of the model to use (e.g. deepseek-chat).",
          "type": "string"
        },
        "prompt": {
          "description": "The prompt to generate completions for.",
          "type": "string"
        },
        "suffix": {
          "description": "The suffix that comes after a completion of inserted text.",
          "type": "string"
        },
        "max_tokens": {
          "description": "The maximum number of tokens to generate.",
          "type": "integer"
        },
        "temperature": {
          "description": "Sampling temperature between 0 and 2.",
          "type": "number"
        },
        "top_p": {
          "description": "Nucleus sampling probability mass.",
          "type": "number"
        },
        "echo": {
          "description": "Echo back the prompt in addition to the completion.",
          "type": "boolean"
        },
        "stop": {
          "description": "Up to 16 sequences where the API will stop generating tokens.",
          "type": "array",
          "schema": {
            "type": "string"
          }
        },
        "stream": {
          "description": "Whether to stream back partial progress via SSE.",
          "type": "boolean"
        }
      }
    },
    "Fim_Completion_Choice": {
      "description": "Completion choice for FIM requests.",
      "type": "struct",
      "properties": {
        "index": {
          "description": "Choice index.",
          "type": "integer"
        },
        "text": {
          "description": "Generated completion text.",
          "type": "string"
        },
        "finish_reason": {
          "description": "Reason the model stopped generating tokens.",
          "type": "string"
        },
        "logprobs": {
          "description": "Logprobs info if requested.",
          "type": "reference",
          "target": "Completion_Choice_Logprobs"
        }
      }
    },
    "Fim_Completion_Response": {
      "description": "Response payload for FIM completion.",
      "type": "struct",
      "properties": {
        "id": {
          "description": "A unique identifier for the completion.",
          "type": "string"
        },
        "object": {
          "description": "The object type, which is 'text_completion'.",
          "type": "string"
        },
        "created": {
          "description": "Unix timestamp of creation time.",
          "type": "integer"
        },
        "model": {
          "description": "Model used for completion.",
          "type": "string"
        },
        "choices": {
          "description": "List of generated choices.",
          "type": "array",
          "schema": {
            "type": "reference",
            "target": "Fim_Completion_Choice"
          }
        },
        "system_fingerprint": {
          "description": "Backend configuration fingerprint.",
          "type": "string"
        },
        "usage": {
          "description": "Usage statistics.",
          "type": "reference",
          "target": "Completion_Usage"
        }
      }
    },
    "Model_Item": {
      "description": "Model details.",
      "type": "struct",
      "properties": {
        "id": {
          "description": "The model identifier.",
          "type": "string"
        },
        "object": {
          "description": "Object type, always 'model'.",
          "type": "string"
        },
        "owned_by": {
          "description": "Organization owning the model.",
          "type": "string"
        }
      }
    },
    "Model_List_Response": {
      "description": "Response containing available models.",
      "type": "struct",
      "properties": {
        "object": {
          "description": "Object type, always 'list'.",
          "type": "string"
        },
        "data": {
          "description": "List of model objects.",
          "type": "array",
          "schema": {
            "type": "reference",
            "target": "Model_Item"
          }
        }
      }
    },
    "User_Balance_Info": {
      "description": "Detailed currency balance info.",
      "type": "struct",
      "properties": {
        "currency": {
          "description": "Currency unit (e.g. CNY, USD).",
          "type": "string"
        },
        "total_balance": {
          "description": "Total available balance.",
          "type": "string"
        },
        "granted_balance": {
          "description": "Granted balance.",
          "type": "string"
        },
        "topped_up_balance": {
          "description": "Topped up balance.",
          "type": "string"
        }
      }
    },
    "User_Balance_Response": {
      "description": "Response structure for user balance query.",
      "type": "struct",
      "properties": {
        "is_available": {
          "description": "Whether the user balance is available.",
          "type": "boolean"
        },
        "balance_infos": {
          "description": "List of balance details per currency.",
          "type": "array",
          "schema": {
            "type": "reference",
            "target": "User_Balance_Info"
          }
        }
      }
    },
    "Error": {
      "description": "Standard error response wrapper.",
      "type": "struct",
      "properties": {
        "error": {
          "description": "",
          "type": "reference",
          "target": "Error_Detail"
        }
      }
    },
    "Error_Detail": {
      "description": "Detailed error message information.",
      "type": "struct",
      "properties": {
        "type": {
          "description": "Error type.",
          "type": "string"
        },
        "message": {
          "description": "Human-readable error description.",
          "type": "string"
        },
        "code": {
          "description": "Error code.",
          "type": "string"
        },
        "param": {
          "description": "Invalid parameter string if applicable.",
          "type": "string"
        }
      }
    }
  }
}